# Database
DB_HOST=db
DB_PORT=5432
DB_USER=incidents_user
DB_PASSWORD=local_dev_password_change_in_prod
DB_NAME=incidents

# LLM (Ollama)
LLM_URL=http://ollama:11434
LLM_MODEL=llama2:7b

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# API
API_BASE_URL=http://localhost:3000

# Optional: Redis
REDIS_URL=redis://redis:6379

# Monitoring
PROMETHEUS_ENABLED=true
